# 10. 定义绘图函数 - 每个蛋白单独绘制
# ============================================================

create_protein_plot <- function(protein, result_data, color_palette) {
  # 准备数据
  detail_data <- data.frame(
    Source = factor(c("Between-study\ndifferences", 
                      "NP properties\n(unique)", 
                      "Methodological\ncovariates (unique)", 
                      "Shared",
                      "Unexplained\n(within-study)"),
                    levels = c("Between-study\ndifferences", 
                               "NP properties\n(unique)", 
                               "Methodological\ncovariates (unique)", 
                               "Shared",
                               "Unexplained\n(within-study)")),
    Percentage = as.numeric(result_data[4:8])
  )
  
  # 创建图形
  p <- ggplot(detail_data, aes(x = Source, y = Percentage, fill = Source)) +
    geom_bar(stat = "identity", width = 0.6) +
    geom_text(aes(label = sprintf("%.1f%%", Percentage)), 
              vjust = -0.3, size = 5.5, fontface = "bold") +
    scale_fill_manual(values = color_palette) +
    scale_y_continuous(limits = c(0, max(detail_data$Percentage) * 1.15),
                       breaks = seq(0, 80, 20),
                       labels = paste0(seq(0, 80, 20), "%"),
                       expand = expansion(mult = c(0, 0.05))) +
    labs(title = paste(protein, "Protein Corona Composition"),
         subtitle = paste0("n = ", result_data$n_samples, 
                           " samples, ", result_data$n_studies, " studies\n",
                           "ICC = ", sprintf("%.1f", result_data$ICC), "% | ",
                           "R² = ", sprintf("%.1f", result_data$R2_full), "%"),
         x = NULL,
         y = "Variance Explained (%)") +
    theme_minimal(base_size = 14) +
    theme(legend.position = "none",
          panel.grid.major.x = element_blank(),
          panel.grid.minor.y = element_blank(),
          plot.title = element_text(face = "bold", size = 18, hjust = 0.5),
          plot.subtitle = element_text(hjust = 0.5, color = "gray50", size = 12),
          axis.text.x = element_text(size = 11, face = "bold"),
          axis.title.y = element_text(face = "bold", size = 13))
  
  return(p)
}

