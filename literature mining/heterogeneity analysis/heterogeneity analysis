# 4. 合并低频分类变量（min_count = 5）
# ============================================================

merge_rare <- function(df, col, min_count = 5) {
  freq <- table(df[[col]])
  rare <- names(freq[freq < min_count])
  if (length(rare) > 0) {
    df[[paste0(col, "_merged")]] <- df[[col]]
    df[[paste0(col, "_merged")]][df[[col]] %in% rare] <- "other"
    cat(col, ": 合并了", length(rare), "个低频类别\n")
  } else {
    df[[paste0(col, "_merged")]] <- df[[col]]
  }
  return(df)
}

