# ============================================================
# 7. 定义分析函数
# ============================================================

analyze_protein <- function(df, protein, np_vars, method_vars) {
  cat("\n========================================\n")
  cat("分析蛋白:", protein, "\n")
  cat("========================================\n")
  
  protein_col <- paste0(protein, "_logit")
  
  # 检查蛋白列是否存在
  if (!protein_col %in% names(df)) {
    cat("警告:", protein_col, "不存在，跳过\n")
    return(NULL)
  }
  
  # 移除该蛋白的缺失值
  df_protein <- df[!is.na(df[[protein_col]]), ]
  cat("样本数:", nrow(df_protein), "\n")
  
  # 空模型
  model_null <- lmer(paste(protein_col, "~ 1 + (1 | Study_ID)"), 
                     data = df_protein, REML = FALSE)
  
  # 仅纳米颗粒性质
  formula_np <- paste(protein_col, "~", paste(np_vars, collapse = " + "), "+ (1 | Study_ID)")
  model_np <- lmer(formula_np, data = df_protein, REML = FALSE)
  
  # 仅方法学协变量
  formula_method <- paste(protein_col, "~", paste(method_vars, collapse = " + "), "+ (1 | Study_ID)")
  model_method <- lmer(formula_method, data = df_protein, REML = FALSE)
  
  # 完整模型
  formula_full <- paste(protein_col, "~", 
                        paste(c(np_vars, method_vars), collapse = " + "), 
                        "+ (1 | Study_ID)")
  model_full <- lmer(formula_full, data = df_protein, REML = FALSE)
  
  # 计算伪R²
  r2_func <- function(model, model_null) {
    n <- length(residuals(model))
    ll_full <- logLik(model)
    ll_null <- logLik(model_null)
    return(1 - exp(-2 * (as.numeric(ll_full) - as.numeric(ll_null)) / n))
  }
  
  r2_full <- r2_func(model_full, model_null)
  r2_np <- r2_func(model_np, model_null)
  r2_method <- r2_func(model_method, model_null)
  
  # 计算独特贡献
  variance_np_unique <- r2_full - r2_method
  variance_method_unique <- r2_full - r2_np
  variance_shared <- r2_np + r2_method - r2_full
  variance_unexplained <- 1 - r2_full
  
  # 计算ICC
  icc_result <- icc(model_null)
  if (!is.null(icc_result$ICC) && length(icc_result$ICC) > 0) {
    icc_value <- as.numeric(icc_result$ICC)
  } else {
    var_random <- as.numeric(VarCorr(model_null)$Study_ID)
    var_residual <- sigma(model_null)^2
    icc_value <- var_random / (var_random + var_residual)
  }
  
  # 构建结果
  result <- data.frame(
    Protein = protein,
    n_samples = nrow(df_protein),
    n_studies = length(unique(df_protein$Study_ID)),
    ICC = icc_value * 100,
    NP_unique = max(0, variance_np_unique * 100),
    Method_unique = max(0, variance_method_unique * 100),
    Shared = max(0, variance_shared * 100),
    Unexplained = max(0, variance_unexplained * 100),
    R2_full = r2_full * 100
  )
  
  # 归一化
  total <- sum(result[4:8])
  if (abs(total - 100) > 0.01 && total > 0) {
    result[4:8] <- result[4:8] / total * 100
  }
  
  return(list(
    result = result,
    models = list(null = model_null, np = model_np, 
                  method = model_method, full = model_full)
  ))
}

